{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/runtime/hook.mjs\" --remind-every-active-turn",
            "timeout": 5,
            "additionalContextLimit": 2500
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/runtime/hook.mjs\" --remind-every-active-turn",
            "timeout": 5,
            "additionalContextLimit": 2500
          }
        ]
      }
    ]
  }
}
